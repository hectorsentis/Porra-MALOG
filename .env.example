# API-Football live scoring. La web nunca llama a esta API directamente:
# cron-job.org -> /api/cron/live-poll -> API-Football -> PostgreSQL -> web.
# Sincronizacion puntual de IDs:
# GET /api/cron/api-football-sync con Authorization: Bearer <CRON_SECRET>
API_FOOTBALL_KEY=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
API_FOOTBALL_LEAGUE_ID="1"
API_FOOTBALL_SEASON="2026"

# ── BBDD principal: Supabase Postgres (migrado desde prisma.io 2026-06-17) ──
# Transaction pooler (puerto 6543) — runtime / app serverless (Vercel)
# Obtener en: Supabase → Project Settings → Database → Connection string → Transaction
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (puerto 5432) — migraciones: npx prisma migrate deploy
# Obtener en: Supabase → Project Settings → Database → Connection string → Session
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# App
NEXT_PUBLIC_APP_NAME="PORRA MUNDIAL 2026 MALOG"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin local. Cambiar en producción.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="porra2026-local-change-me"
ADMIN_SESSION_SECRET="replace-with-random-strong-secret"
JWT_SECRET="replace-with-random-strong-chat-secret"

# Chat Supabase. El service role solo se usa en endpoints server.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE=""
NEXT_SUPABASE_SECRET_KEY=""
SUPABASE_DIRECT_URL=""
CHAT_PRISMA_READONLY_URL=""

# Optional automation
CRON_SECRET=""
REVALIDATE_SECRET=""
GITHUB_ACTIONS_IMPORT_SECRET=""

# football-data.org live scoring (10 calls/min free tier).
# La web nunca llama a esta API directamente:
# cron-job.org -> /api/cron/live-poll -> football-data.org -> PostgreSQL -> web.
# Sincronizacion puntual de IDs:
# GET /api/cron/api-football-sync con Authorization: Bearer <CRON_SECRET>
FOOTBALL_DATA_KEY=""

# Activar logs de cada llamada a football-data.org
# API_FOOTBALL_DEBUG=1
